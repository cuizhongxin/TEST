<!--pages/character/character.wxml - 将领详情页-->
<view class="page-container">
  <!-- 顶部标签栏 -->
  <view class="tabs">
    <view class="tab-item {{activeTab === 'recruit' ? 'active' : ''}}" bindtap="switchTab" data-tab="recruit">
      <text>将领招募</text>
    </view>
    <view class="tab-item {{activeTab === 'equip' ? 'active' : ''}}" bindtap="switchTab" data-tab="equip">
      <text>将领装备</text>
    </view>
    <view class="tab-item {{activeTab === 'tactics' ? 'active' : ''}}" bindtap="switchTab" data-tab="tactics">
      <text>将领兵法</text>
    </view>
    <view class="tab-item {{activeTab === 'train' ? 'active' : ''}}" bindtap="switchTab" data-tab="train">
      <text>将领训练</text>
    </view>
    <view class="tab-item {{activeTab === 'exp' ? 'active' : ''}}" bindtap="switchTab" data-tab="exp">
      <text>经验药</text>
    </view>
    <view class="tab-item {{activeTab === 'soldier' ? 'active' : ''}}" bindtap="switchTab" data-tab="soldier">
      <text>士兵</text>
    </view>
    <view class="back-btn" bindtap="goBack">返回</view>
  </view>

  <view class="main-content">
    <!-- 左侧将领列表 -->
    <view class="left-panel">
      <scroll-view scroll-y class="general-scroll">
        <view class="general-item {{selectedGeneral && selectedGeneral.id === item.id ? 'active' : ''}}"
              wx:for="{{generals}}" wx:key="id"
              bindtap="selectGeneral" data-general="{{item}}">
          <view class="general-avatar quality-border-{{item.quality.id || 3}}">
            <image src="{{item.avatar || '/images/avatar-default.png'}}" mode="aspectFill"></image>
          </view>
          <text class="general-name quality-{{item.quality.id || 3}}">{{item.name}}</text>
        </view>
      </scroll-view>
    </view>

    <!-- 中间将领详情 -->
    <view class="center-panel" wx:if="{{selectedGeneral}}">
      <!-- 头像区域 -->
      <view class="portrait-area">
        <view class="portrait quality-border-{{selectedGeneral.quality.id || 3}}">
          <image src="{{selectedGeneral.avatar || '/images/avatar-default.png'}}" mode="aspectFill"></image>
        </view>
      </view>
      
      <!-- 基本信息 -->
      <view class="info-area">
        <view class="info-row name-row">
          <text class="general-name-big quality-{{selectedGeneral.quality.id || 3}}">{{selectedGeneral.name}}</text>
          <text class="level-text">LV:{{selectedGeneral.level || 1}}</text>
        </view>
        <view class="info-row troop-row">
          <text class="troop-label">统领部队：</text>
          <text class="troop-value">{{selectedGeneral.troopTypeName || '精锐部队'}}({{selectedGeneral.troopRank || 1}}阶{{selectedGeneral.troopType.name || '步'}}兵)</text>
        </view>
        <view class="stats-grid">
          <view class="stat-item">
            <text class="stat-label">武勇：</text>
            <text class="stat-value">{{selectedGeneral.attributes.valor || 0}}</text>
          </view>
          <view class="stat-item">
            <text class="stat-label">统御：</text>
            <text class="stat-value">{{selectedGeneral.attributes.command || 0}}</text>
          </view>
          <view class="stat-item">
            <text class="stat-label">攻击：</text>
            <text class="stat-value attack">{{selectedGeneral.attributes.attack || 0}}</text>
          </view>
          <view class="stat-item">
            <text class="stat-label">防御：</text>
            <text class="stat-value defense">{{selectedGeneral.attributes.defense || 0}}</text>
          </view>
        </view>
      </view>

      <!-- 当前兵法展示 -->
      <view class="equipped-tactic" wx:if="{{activeTab === 'tactics' && selectedTactic}}">
        <view class="tactic-icon-big">
          <image src="{{selectedTactic.icon || '/images/tactic-default.png'}}" mode="aspectFill"></image>
        </view>
        <view class="tactic-info-detail">
          <view class="tactic-name-row">
            <text class="tactic-name quality-{{selectedTactic.quality || 3}}">{{selectedTactic.name}}</text>
            <text class="tactic-type">({{selectedTactic.type || '绑定'}})</text>
          </view>
          <text class="tactic-apply">适用兵种:{{selectedTactic.troopType || '弓兵'}}</text>
          <text class="tactic-level">当前等级:{{selectedTactic.level || 1}}级</text>
        </view>
      </view>

      <!-- 装备槽位（装备Tab） -->
      <view class="equip-slots" wx:if="{{activeTab === 'equip'}}">
        <view class="equip-slot" wx:for="{{equipSlots}}" wx:key="id"
              bindtap="onEquipSlotTap" data-slot="{{item}}">
          <view class="slot-icon">
            <image wx:if="{{generalEquipments[item.id]}}" 
                   src="{{generalEquipments[item.id].icon || '/images/equip-default.png'}}" 
                   mode="aspectFill"></image>
            <text wx:else class="empty-icon">{{item.icon}}</text>
          </view>
          <text class="slot-name">{{generalEquipments[item.id] ? generalEquipments[item.id].name : item.name}}</text>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="action-buttons">
        <view class="action-btn dismiss" bindtap="showDismissConfirm">解雇</view>
        <view class="action-btn upgrade" wx:if="{{activeTab === 'tactics'}}" bindtap="upgradeTactic">兵法升级</view>
      </view>
    </view>

    <!-- 右侧面板 -->
    <view class="right-panel">
      <!-- 兵法面板 -->
      <view class="tactics-panel" wx:if="{{activeTab === 'tactics'}}">
        <view class="panel-header">
          <text class="panel-title">兵法</text>
          <view class="upgrade-btn" bindtap="upgradeTactic">兵法升级</view>
        </view>
        
        <!-- 已装备兵法槽 -->
        <view class="tactics-slots">
          <view class="tactic-slot {{item.equipped ? 'equipped' : 'empty'}} {{selectedTacticSlot === index ? 'selected' : ''}}"
                wx:for="{{tacticSlots}}" wx:key="index" wx:for-index="index"
                bindtap="selectTacticSlot" data-index="{{index}}">
            <image wx:if="{{item.equipped}}" src="{{item.icon || '/images/tactic-default.png'}}" mode="aspectFill"></image>
            <view wx:else class="slot-pattern">
              <view class="pattern-dot"></view>
              <view class="pattern-line h"></view>
              <view class="pattern-line v"></view>
            </view>
            <text class="tactic-slot-level" wx:if="{{item.equipped}}">{{item.level}}级</text>
          </view>
        </view>

        <!-- 兵法效果说明 -->
        <view class="tactic-effect" wx:if="{{selectedTactic}}">
          <view class="effect-title">兵法效果：</view>
          <text class="effect-desc">{{selectedTactic.effect || '弓兵兵法，穿透性攻击，对同一行所有敌人造成85%伤害'}}</text>
        </view>

        <!-- 可用兵法列表 -->
        <view class="available-tactics">
          <view class="section-title">可装备兵法</view>
          <scroll-view scroll-y class="tactics-scroll">
            <view class="tactic-item {{selectedAvailableTactic === item.id ? 'selected' : ''}}"
                  wx:for="{{availableTactics}}" wx:key="id"
                  bindtap="selectAvailableTactic" data-tactic="{{item}}">
              <view class="tactic-icon">
                <image src="{{item.icon || '/images/tactic-default.png'}}" mode="aspectFill"></image>
              </view>
              <view class="tactic-brief">
                <text class="tactic-name quality-{{item.quality || 3}}">{{item.name}}</text>
                <text class="tactic-lv">{{item.level}}级</text>
              </view>
            </view>
          </scroll-view>
        </view>

        <!-- 装备/卸下按钮 -->
        <view class="tactic-actions">
          <view class="tactic-btn equip" bindtap="equipTactic" 
                wx:if="{{selectedAvailableTactic && selectedTacticSlot !== null}}">装备兵法</view>
          <view class="tactic-btn unequip" bindtap="unequipTactic"
                wx:if="{{selectedTacticSlot !== null && tacticSlots[selectedTacticSlot] && tacticSlots[selectedTacticSlot].equipped}}">卸下</view>
        </view>
      </view>

      <!-- 装备面板 -->
      <view class="equipment-panel" wx:if="{{activeTab === 'equip'}}">
        <view class="panel-header">
          <text class="panel-title">装备列表</text>
        </view>
        <scroll-view scroll-y class="equipment-scroll">
          <view class="equip-item {{selectedEquip === item.id ? 'selected' : ''}}"
                wx:for="{{warehouseEquipments}}" wx:key="id"
                bindtap="selectEquipment" data-equip="{{item}}">
            <view class="equip-icon quality-border-{{item.quality || 3}}">
              <image src="{{item.icon || '/images/equip-default.png'}}" mode="aspectFill"></image>
            </view>
            <view class="equip-info">
              <text class="equip-name quality-{{item.quality || 3}}">{{item.name}}</text>
              <text class="equip-type">{{item.slotType.name || '装备'}}</text>
            </view>
            <text class="equip-enhance" wx:if="{{item.enhanceLevel}}">+{{item.enhanceLevel}}</text>
          </view>
        </scroll-view>
        <view class="equip-actions">
          <view class="equip-btn" bindtap="equipItem" wx:if="{{selectedEquip}}">装备</view>
        </view>
      </view>

      <!-- 招募面板 -->
      <view class="recruit-panel" wx:if="{{activeTab === 'recruit'}}">
        <view class="panel-header">
          <text class="panel-title">将领招募</text>
        </view>
        <view class="recruit-options">
          <view class="recruit-item" bindtap="doRecruit" data-type="basic">
            <view class="recruit-icon">📜</view>
            <text class="recruit-name">普通招贤令</text>
            <text class="recruit-count">x{{recruitItems.basic || 0}}</text>
            <text class="recruit-desc">必得优秀及以上将领</text>
          </view>
          <view class="recruit-item gold" bindtap="doRecruit" data-type="advanced">
            <view class="recruit-icon">📯</view>
            <text class="recruit-name">高级招贤令</text>
            <text class="recruit-count">x{{recruitItems.advanced || 0}}</text>
            <text class="recruit-desc">必得史诗及以上将领</text>
          </view>
          <view class="recruit-item legend" bindtap="doRecruit" data-type="legend">
            <view class="recruit-icon">🎺</view>
            <text class="recruit-name">传说招贤令</text>
            <text class="recruit-count">x{{recruitItems.legend || 0}}</text>
            <text class="recruit-desc">必得传说将领</text>
          </view>
        </view>
      </view>

      <!-- 训练面板（传承） -->
      <view class="train-panel" wx:if="{{activeTab === 'train'}}">
        <view class="panel-header">
          <text class="panel-title">将领传承</text>
        </view>
        <view class="train-desc">选择传承符，将一个将领的经验传承给当前将领。被传承的将领将消失。</view>
        
        <view class="scroll-list">
          <view class="scroll-item {{selectedScroll === item.id ? 'selected' : ''}}"
                wx:for="{{inheritScrolls}}" wx:key="id"
                bindtap="selectInheritScroll" data-id="{{item.id}}">
            <view class="scroll-icon">📜</view>
            <text class="scroll-name">{{item.name}}</text>
            <text class="scroll-rate">{{item.rate}}%</text>
            <text class="scroll-count">x{{item.count}}</text>
          </view>
        </view>

        <view class="inherit-select">
          <view class="inherit-source" bindtap="selectSourceGeneral">
            <image wx:if="{{sourceGeneral}}" src="{{sourceGeneral.avatar}}" mode="aspectFill"></image>
            <text wx:else>选择源将领</text>
            <text class="source-name" wx:if="{{sourceGeneral}}">{{sourceGeneral.name}}</text>
          </view>
          <text class="inherit-arrow">→</text>
          <view class="inherit-target">
            <image wx:if="{{selectedGeneral}}" src="{{selectedGeneral.avatar}}" mode="aspectFill"></image>
            <text class="target-name" wx:if="{{selectedGeneral}}">{{selectedGeneral.name}}</text>
          </view>
        </view>

        <view class="inherit-preview" wx:if="{{inheritExpPreview > 0}}">
          预计传承经验: <text class="exp-value">{{inheritExpPreview}}</text>
        </view>

        <view class="train-btn {{!canInherit ? 'disabled' : ''}}" bindtap="doInherit">开始传承</view>
      </view>

      <!-- 经验药面板 -->
      <view class="exp-panel" wx:if="{{activeTab === 'exp'}}">
        <view class="panel-header">
          <text class="panel-title">军事演习</text>
        </view>
        <view class="exp-desc">使用演习令快速提升将领等级</view>
        
        <view class="drill-items">
          <view class="drill-item {{selectedDrill === item.id ? 'selected' : ''}}"
                wx:for="{{drillItems}}" wx:key="id"
                bindtap="selectDrillItem" data-id="{{item.id}}">
            <view class="drill-icon">{{item.icon}}</view>
            <text class="drill-name">{{item.name}}</text>
            <text class="drill-exp">+{{item.exp}}经验</text>
            <text class="drill-count">x{{item.count}}</text>
          </view>
        </view>

        <view class="drill-control" wx:if="{{selectedDrill}}">
          <text>使用数量：</text>
          <view class="count-btns">
            <view class="count-btn" bindtap="decreaseDrillCount">-</view>
            <text class="count-num">{{drillCount}}</text>
            <view class="count-btn" bindtap="increaseDrillCount">+</view>
          </view>
          <view class="max-btn" bindtap="maxDrillCount">最大</view>
        </view>

        <view class="drill-preview" wx:if="{{drillExpPreview > 0}}">
          预计获得经验: <text class="exp-value">{{drillExpPreview}}</text>
        </view>

        <view class="exp-btn {{!canDrill ? 'disabled' : ''}}" bindtap="doDrill">开始演习</view>
      </view>

      <!-- 士兵面板 -->
      <view class="soldier-panel" wx:if="{{activeTab === 'soldier'}}">
        <view class="panel-header">
          <text class="panel-title">士兵管理</text>
        </view>
        <view class="soldier-info" wx:if="{{selectedGeneral}}">
          <view class="soldier-row">
            <text class="soldier-label">当前兵种：</text>
            <text class="soldier-value">{{selectedGeneral.troopType.name || '步兵'}}</text>
          </view>
          <view class="soldier-row">
            <text class="soldier-label">士兵数量：</text>
            <text class="soldier-value">{{selectedGeneral.soldiers.count || 0}}/{{selectedGeneral.soldiers.max || 100}}</text>
          </view>
          <view class="soldier-row">
            <text class="soldier-label">兵种阶级：</text>
            <text class="soldier-value">{{selectedGeneral.troopRank || 1}}阶</text>
          </view>
        </view>
        <view class="soldier-actions">
          <view class="soldier-btn" bindtap="recruitSoldiers">补充士兵</view>
          <view class="soldier-btn upgrade" bindtap="upgradeTroop">升阶兵种</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 解雇确认弹窗 -->
  <view class="modal-mask" wx:if="{{showDismissModal}}" bindtap="closeDismissModal">
    <view class="modal-content" catchtap="">
      <view class="modal-title">解雇将领</view>
      <view class="modal-body">
        <text>确定要解雇【{{selectedGeneral.name}}】吗？</text>
        <text class="warning">解雇后将领将永久消失！</text>
      </view>
      <view class="modal-footer">
        <view class="modal-btn cancel" bindtap="closeDismissModal">取消</view>
        <view class="modal-btn confirm" bindtap="doDismiss">确认</view>
      </view>
    </view>
  </view>

  <!-- 选择源将领弹窗 -->
  <view class="modal-mask" wx:if="{{showSourceModal}}" bindtap="closeSourceModal">
    <view class="modal-content large" catchtap="">
      <view class="modal-title">选择源将领</view>
      <scroll-view scroll-y class="modal-list">
        <view class="modal-general-item" 
              wx:for="{{generals}}" wx:key="id"
              wx:if="{{!selectedGeneral || item.id !== selectedGeneral.id}}"
              bindtap="confirmSourceGeneral" data-general="{{item}}">
          <image src="{{item.avatar}}" mode="aspectFill"></image>
          <text class="modal-general-name">{{item.name}}</text>
          <text class="modal-general-exp">经验:{{item.exp}}</text>
        </view>
      </scroll-view>
      <view class="modal-close" bindtap="closeSourceModal">关闭</view>
    </view>
  </view>

  <!-- 招募结果弹窗 -->
  <view class="modal-mask" wx:if="{{showRecruitResult}}" bindtap="closeRecruitResult">
    <view class="modal-content recruit-result" catchtap="">
      <view class="modal-title">招募成功</view>
      <view class="recruit-general" wx:if="{{recruitedGeneral}}">
        <view class="recruit-portrait quality-border-{{recruitedGeneral.quality.id || 3}}">
          <image src="{{recruitedGeneral.avatar}}" mode="aspectFill"></image>
        </view>
        <text class="recruit-name quality-{{recruitedGeneral.quality.id || 3}}">{{recruitedGeneral.name}}</text>
        <text class="recruit-quality">{{recruitedGeneral.quality.name || '优秀'}}</text>
      </view>
      <view class="modal-btn confirm" bindtap="closeRecruitResult">确定</view>
    </view>
  </view>
</view>
