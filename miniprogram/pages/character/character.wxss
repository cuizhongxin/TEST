/* pages/character/character.wxss - 将领详情页样式 */
page {
  background: #1a1208;
}

.page-container {
  width: 100vw;
  height: 100vh;
  background: linear-gradient(180deg, #2a1a0a 0%, #1a1208 50%, #0d0a05 100%);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ========== 顶部标签栏 ========== */
.tabs {
  display: flex;
  align-items: center;
  background: linear-gradient(180deg, #3d2a1a 0%, #2a1a0a 100%);
  border-bottom: 2rpx solid #8b6914;
  padding: 0 10rpx;
  flex-shrink: 0;
  height: 70rpx;
}

.tab-item {
  padding: 15rpx 20rpx;
  text-align: center;
  color: #a08060;
  font-size: 24rpx;
  border-bottom: 3rpx solid transparent;
  white-space: nowrap;
}

.tab-item.active {
  color: #ffd700;
  border-bottom-color: #ffd700;
  background: linear-gradient(180deg, transparent 0%, rgba(255,215,0,0.15) 100%);
}

.back-btn {
  margin-left: auto;
  padding: 10rpx 25rpx;
  background: linear-gradient(180deg, #5a4020 0%, #3a2810 100%);
  border: 1rpx solid #8b6914;
  border-radius: 6rpx;
  color: #ffd700;
  font-size: 22rpx;
}

/* ========== 主内容区 ========== */
.main-content {
  flex: 1;
  display: flex;
  padding: 12rpx;
  gap: 12rpx;
  overflow: hidden;
}

/* ========== 左侧将领列表 ========== */
.left-panel {
  width: 160rpx;
  background: rgba(0,0,0,0.6);
  border: 2rpx solid #5a4020;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.general-scroll {
  flex: 1;
  overflow-y: auto;
}

.general-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 8rpx;
  border-bottom: 1rpx solid rgba(90,64,32,0.5);
  gap: 6rpx;
}

.general-item.active {
  background: linear-gradient(90deg, rgba(255,215,0,0.3) 0%, rgba(255,215,0,0.1) 100%);
  border-left: 4rpx solid #ffd700;
}

.general-avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 8rpx;
  overflow: hidden;
  border: 2rpx solid #5a4020;
  background: #2a1a0a;
}

.general-avatar image {
  width: 100%;
  height: 100%;
}

.general-name {
  font-size: 20rpx;
  text-align: center;
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 品质颜色 */
.quality-1 { color: #888; }
.quality-2 { color: #55ff55; }
.quality-3 { color: #5599ff; }
.quality-4 { color: #cc77ff; }
.quality-5 { color: #ff9933; }
.quality-6 { color: #ff4444; }

.quality-border-1 { border-color: #888 !important; }
.quality-border-2 { border-color: #55ff55 !important; }
.quality-border-3 { border-color: #5599ff !important; }
.quality-border-4 { border-color: #cc77ff !important; }
.quality-border-5 { border-color: #ff9933 !important; }
.quality-border-6 { border-color: #ff4444 !important; }

/* ========== 中间将领详情 ========== */
.center-panel {
  width: 320rpx;
  background: rgba(0,0,0,0.5);
  border: 2rpx solid #5a4020;
  border-radius: 8rpx;
  padding: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  overflow-y: auto;
}

.portrait-area {
  display: flex;
  justify-content: center;
}

.portrait {
  width: 140rpx;
  height: 140rpx;
  border-radius: 10rpx;
  overflow: hidden;
  border: 3rpx solid #ffd700;
  background: linear-gradient(135deg, #3a2a1a 0%, #2a1a0a 100%);
}

.portrait image {
  width: 100%;
  height: 100%;
}

.info-area {
  background: rgba(0,0,0,0.3);
  border-radius: 6rpx;
  padding: 10rpx;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.name-row {
  justify-content: space-between;
  padding-bottom: 8rpx;
  border-bottom: 1rpx solid rgba(139,105,20,0.3);
  margin-bottom: 8rpx;
}

.general-name-big {
  font-size: 28rpx;
  font-weight: bold;
}

.level-text {
  font-size: 22rpx;
  color: #7fff00;
  background: rgba(0,100,0,0.3);
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}

.troop-row {
  flex-wrap: wrap;
}

.troop-label {
  font-size: 20rpx;
  color: #a08060;
}

.troop-value {
  font-size: 20rpx;
  color: #ffd700;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6rpx;
  margin-top: 8rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.stat-label {
  font-size: 20rpx;
  color: #a08060;
}

.stat-value {
  font-size: 20rpx;
  color: #fff;
}

.stat-value.attack { color: #ff6666; }
.stat-value.defense { color: #66ff66; }

/* 当前兵法展示 */
.equipped-tactic {
  display: flex;
  gap: 12rpx;
  background: rgba(0,0,0,0.4);
  border: 1rpx solid #5a4020;
  border-radius: 6rpx;
  padding: 10rpx;
}

.tactic-icon-big {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  overflow: hidden;
  border: 2rpx solid #cc77ff;
  background: #2a1a3a;
}

.tactic-icon-big image {
  width: 100%;
  height: 100%;
}

.tactic-info-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.tactic-name-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.tactic-name {
  font-size: 22rpx;
  font-weight: bold;
}

.tactic-type, .tactic-apply, .tactic-level {
  font-size: 18rpx;
  color: #a08060;
}

/* 装备槽位 */
.equip-slots {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
}

.equip-slot {
  background: rgba(0,0,0,0.4);
  border: 1rpx solid #5a4020;
  border-radius: 6rpx;
  padding: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.slot-icon {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(90,64,32,0.3);
  border-radius: 6rpx;
}

.slot-icon image {
  width: 100%;
  height: 100%;
}

.empty-icon {
  font-size: 24rpx;
}

.slot-name {
  font-size: 18rpx;
  color: #a08060;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 10rpx;
  margin-top: auto;
}

.action-btn {
  flex: 1;
  padding: 12rpx;
  text-align: center;
  border-radius: 6rpx;
  font-size: 22rpx;
}

.action-btn.dismiss {
  background: linear-gradient(180deg, #5a2020 0%, #3a1010 100%);
  border: 1rpx solid #8b3030;
  color: #ff6666;
}

.action-btn.upgrade {
  background: linear-gradient(180deg, #205a20 0%, #103a10 100%);
  border: 1rpx solid #308b30;
  color: #66ff66;
}

/* ========== 右侧面板 ========== */
.right-panel {
  flex: 1;
  background: rgba(0,0,0,0.5);
  border: 2rpx solid #5a4020;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 15rpx;
  background: linear-gradient(90deg, rgba(139,105,20,0.6) 0%, transparent 100%);
  border-bottom: 1rpx solid #5a4020;
}

.panel-title {
  font-size: 24rpx;
  color: #ffd700;
  font-weight: bold;
}

.upgrade-btn {
  padding: 6rpx 16rpx;
  background: linear-gradient(180deg, #4a6020 0%, #2a4010 100%);
  border: 1rpx solid #6a8030;
  border-radius: 4rpx;
  font-size: 20rpx;
  color: #bfff00;
}

/* ========== 兵法面板 ========== */
.tactics-panel {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.tactics-slots {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  padding: 12rpx;
  background: rgba(0,0,0,0.3);
}

.tactic-slot {
  aspect-ratio: 1;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.tactic-slot.empty {
  background: rgba(40,30,20,0.8);
  border: 2rpx dashed #5a4020;
}

.tactic-slot.equipped {
  background: linear-gradient(135deg, #3a2a1a 0%, #2a1a0a 100%);
  border: 2rpx solid #8b6914;
}

.tactic-slot.selected {
  border-color: #ffd700;
  box-shadow: 0 0 10rpx rgba(255,215,0,0.5);
}

.tactic-slot image {
  width: 100%;
  height: 100%;
}

.slot-pattern {
  position: relative;
  width: 60%;
  height: 60%;
}

.pattern-dot {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  background: #5a4020;
  border-radius: 50%;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.pattern-line {
  position: absolute;
  background: #5a4020;
}

.pattern-line.h {
  width: 100%;
  height: 2rpx;
  top: 50%;
  left: 0;
  transform: translateY(-50%);
}

.pattern-line.v {
  width: 2rpx;
  height: 100%;
  left: 50%;
  top: 0;
  transform: translateX(-50%);
}

.tactic-slot-level {
  position: absolute;
  bottom: 2rpx;
  right: 4rpx;
  font-size: 16rpx;
  color: #7fff00;
  text-shadow: 0 0 4rpx #000;
}

.tactic-effect {
  padding: 10rpx 12rpx;
  background: rgba(0,0,0,0.4);
  margin: 0 12rpx;
  border-radius: 6rpx;
}

.effect-title {
  font-size: 20rpx;
  color: #ffd700;
  margin-bottom: 4rpx;
}

.effect-desc {
  font-size: 18rpx;
  color: #a08060;
  line-height: 1.4;
}

.available-tactics {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 0 12rpx;
  overflow: hidden;
}

.section-title {
  font-size: 20rpx;
  color: #a08060;
  padding: 8rpx 0;
  border-bottom: 1rpx solid rgba(90,64,32,0.5);
}

.tactics-scroll {
  flex: 1;
  overflow-y: auto;
}

.tactic-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx;
  border-bottom: 1rpx solid rgba(90,64,32,0.3);
}

.tactic-item.selected {
  background: rgba(255,215,0,0.15);
}

.tactic-icon {
  width: 50rpx;
  height: 50rpx;
  border-radius: 6rpx;
  overflow: hidden;
  border: 2rpx solid #5a4020;
  background: #2a1a0a;
}

.tactic-icon image {
  width: 100%;
  height: 100%;
}

.tactic-brief {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.tactic-lv {
  font-size: 18rpx;
  color: #7fff00;
}

.tactic-actions {
  display: flex;
  gap: 10rpx;
  padding: 12rpx;
}

.tactic-btn {
  flex: 1;
  padding: 14rpx;
  text-align: center;
  border-radius: 6rpx;
  font-size: 24rpx;
  font-weight: bold;
}

.tactic-btn.equip {
  background: linear-gradient(180deg, #4a6020 0%, #2a4010 100%);
  border: 2rpx solid #6a8030;
  color: #bfff00;
}

.tactic-btn.unequip {
  background: linear-gradient(180deg, #5a4020 0%, #3a2810 100%);
  border: 2rpx solid #8b6020;
  color: #ffd700;
}

/* ========== 装备面板 ========== */
.equipment-panel {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.equipment-scroll {
  flex: 1;
  padding: 10rpx;
  overflow-y: auto;
}

.equip-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx;
  background: rgba(0,0,0,0.3);
  border-radius: 6rpx;
  margin-bottom: 8rpx;
  border: 1rpx solid transparent;
}

.equip-item.selected {
  border-color: #ffd700;
  background: rgba(255,215,0,0.1);
}

.equip-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 6rpx;
  overflow: hidden;
  border: 2rpx solid #5a4020;
  background: #2a1a0a;
}

.equip-icon image {
  width: 100%;
  height: 100%;
}

.equip-info {
  flex: 1;
}

.equip-name {
  font-size: 22rpx;
  display: block;
}

.equip-type {
  font-size: 18rpx;
  color: #a08060;
}

.equip-enhance {
  font-size: 20rpx;
  color: #7fff00;
}

.equip-actions {
  padding: 12rpx;
}

.equip-btn {
  padding: 14rpx;
  text-align: center;
  background: linear-gradient(180deg, #4a6020 0%, #2a4010 100%);
  border: 2rpx solid #6a8030;
  border-radius: 6rpx;
  color: #bfff00;
  font-size: 24rpx;
  font-weight: bold;
}

/* ========== 招募面板 ========== */
.recruit-panel {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.recruit-options {
  padding: 15rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.recruit-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 15rpx;
  background: linear-gradient(90deg, rgba(60,60,100,0.4) 0%, rgba(40,40,80,0.2) 100%);
  border: 2rpx solid #5566aa;
  border-radius: 8rpx;
}

.recruit-item.gold {
  background: linear-gradient(90deg, rgba(100,80,40,0.4) 0%, rgba(80,60,20,0.2) 100%);
  border-color: #aa8833;
}

.recruit-item.legend {
  background: linear-gradient(90deg, rgba(100,40,60,0.4) 0%, rgba(80,20,40,0.2) 100%);
  border-color: #cc5577;
}

.recruit-icon {
  font-size: 40rpx;
}

.recruit-name {
  flex: 1;
  font-size: 24rpx;
  color: #fff;
}

.recruit-count {
  font-size: 22rpx;
  color: #7fff00;
  margin-right: 10rpx;
}

.recruit-desc {
  font-size: 18rpx;
  color: #a08060;
}

/* ========== 训练/传承面板 ========== */
.train-panel {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 12rpx;
}

.train-desc {
  font-size: 20rpx;
  color: #a08060;
  padding: 10rpx;
  background: rgba(0,0,0,0.3);
  border-radius: 6rpx;
  margin-bottom: 12rpx;
}

.scroll-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 15rpx;
}

.scroll-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx;
  background: rgba(0,0,0,0.3);
  border: 1rpx solid #5a4020;
  border-radius: 6rpx;
}

.scroll-item.selected {
  border-color: #ffd700;
  background: rgba(255,215,0,0.1);
}

.scroll-icon {
  font-size: 28rpx;
}

.scroll-name {
  flex: 1;
  font-size: 22rpx;
  color: #fff;
}

.scroll-rate {
  font-size: 20rpx;
  color: #7fff00;
}

.scroll-count {
  font-size: 20rpx;
  color: #ffd700;
}

.inherit-select {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 15rpx;
  background: rgba(0,0,0,0.3);
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.inherit-source, .inherit-target {
  width: 100rpx;
  height: 100rpx;
  border-radius: 10rpx;
  border: 2rpx dashed #5a4020;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(0,0,0,0.4);
  overflow: hidden;
  font-size: 18rpx;
  color: #a08060;
}

.inherit-source image, .inherit-target image {
  width: 100%;
  height: 100%;
}

.source-name, .target-name {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0,0,0,0.7);
  font-size: 16rpx;
  color: #fff;
  text-align: center;
  padding: 2rpx;
}

.inherit-arrow {
  font-size: 36rpx;
  color: #ffd700;
}

.inherit-preview {
  text-align: center;
  font-size: 22rpx;
  color: #a08060;
  padding: 10rpx;
  background: rgba(0,100,0,0.2);
  border-radius: 6rpx;
  margin-bottom: 12rpx;
}

.exp-value {
  color: #7fff00;
  font-weight: bold;
}

.train-btn {
  padding: 16rpx;
  text-align: center;
  background: linear-gradient(180deg, #4a6020 0%, #2a4010 100%);
  border: 2rpx solid #6a8030;
  border-radius: 6rpx;
  color: #bfff00;
  font-size: 26rpx;
  font-weight: bold;
}

.train-btn.disabled {
  background: #333;
  border-color: #444;
  color: #666;
}

/* ========== 经验药面板 ========== */
.exp-panel {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 12rpx;
}

.exp-desc {
  font-size: 20rpx;
  color: #a08060;
  margin-bottom: 12rpx;
}

.drill-items {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 15rpx;
}

.drill-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx;
  background: rgba(0,0,0,0.3);
  border: 1rpx solid #5a4020;
  border-radius: 6rpx;
}

.drill-item.selected {
  border-color: #ffd700;
  background: rgba(255,215,0,0.1);
}

.drill-icon {
  font-size: 28rpx;
}

.drill-name {
  flex: 1;
  font-size: 22rpx;
  color: #fff;
}

.drill-exp {
  font-size: 20rpx;
  color: #7fff00;
}

.drill-count {
  font-size: 20rpx;
  color: #ffd700;
}

.drill-control {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15rpx;
  padding: 12rpx;
  background: rgba(0,0,0,0.3);
  border-radius: 6rpx;
  margin-bottom: 12rpx;
}

.count-btns {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.count-btn {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #5a4020;
  border-radius: 6rpx;
  color: #ffd700;
  font-size: 28rpx;
}

.count-num {
  width: 60rpx;
  text-align: center;
  font-size: 26rpx;
  color: #fff;
}

.max-btn {
  padding: 8rpx 16rpx;
  background: #4a6020;
  border-radius: 4rpx;
  color: #bfff00;
  font-size: 20rpx;
}

.drill-preview {
  text-align: center;
  font-size: 22rpx;
  color: #a08060;
  padding: 10rpx;
  background: rgba(0,100,0,0.2);
  border-radius: 6rpx;
  margin-bottom: 12rpx;
}

.exp-btn {
  padding: 16rpx;
  text-align: center;
  background: linear-gradient(180deg, #4a6020 0%, #2a4010 100%);
  border: 2rpx solid #6a8030;
  border-radius: 6rpx;
  color: #bfff00;
  font-size: 26rpx;
  font-weight: bold;
  margin-top: auto;
}

.exp-btn.disabled {
  background: #333;
  border-color: #444;
  color: #666;
}

/* ========== 士兵面板 ========== */
.soldier-panel {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 12rpx;
}

.soldier-info {
  background: rgba(0,0,0,0.3);
  border-radius: 6rpx;
  padding: 15rpx;
  margin-bottom: 15rpx;
}

.soldier-row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  border-bottom: 1rpx solid rgba(90,64,32,0.3);
}

.soldier-row:last-child {
  border-bottom: none;
}

.soldier-label {
  font-size: 22rpx;
  color: #a08060;
}

.soldier-value {
  font-size: 22rpx;
  color: #fff;
}

.soldier-actions {
  display: flex;
  gap: 12rpx;
}

.soldier-btn {
  flex: 1;
  padding: 14rpx;
  text-align: center;
  background: linear-gradient(180deg, #4a6020 0%, #2a4010 100%);
  border: 2rpx solid #6a8030;
  border-radius: 6rpx;
  color: #bfff00;
  font-size: 22rpx;
}

.soldier-btn.upgrade {
  background: linear-gradient(180deg, #604a20 0%, #402a10 100%);
  border-color: #806a30;
  color: #ffd700;
}

/* ========== 弹窗样式 ========== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 500rpx;
  background: linear-gradient(180deg, #3a2a1a 0%, #2a1a0a 100%);
  border: 2rpx solid #8b6914;
  border-radius: 12rpx;
  padding: 20rpx;
}

.modal-content.large {
  width: 600rpx;
  max-height: 70vh;
}

.modal-title {
  font-size: 28rpx;
  color: #ffd700;
  text-align: center;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #5a4020;
  margin-bottom: 15rpx;
}

.modal-body {
  text-align: center;
  padding: 20rpx 0;
}

.modal-body text {
  display: block;
  font-size: 24rpx;
  color: #fff;
  margin-bottom: 10rpx;
}

.modal-body .warning {
  color: #ff6666;
  font-size: 22rpx;
}

.modal-footer {
  display: flex;
  gap: 15rpx;
  margin-top: 15rpx;
}

.modal-btn {
  flex: 1;
  padding: 16rpx;
  text-align: center;
  border-radius: 6rpx;
  font-size: 24rpx;
}

.modal-btn.cancel {
  background: #333;
  border: 1rpx solid #555;
  color: #999;
}

.modal-btn.confirm {
  background: linear-gradient(180deg, #5a2020 0%, #3a1010 100%);
  border: 1rpx solid #8b3030;
  color: #ff6666;
}

.modal-list {
  max-height: 400rpx;
  overflow-y: auto;
}

.modal-general-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx;
  background: rgba(0,0,0,0.3);
  border-radius: 6rpx;
  margin-bottom: 8rpx;
}

.modal-general-item image {
  width: 60rpx;
  height: 60rpx;
  border-radius: 6rpx;
}

.modal-general-name {
  flex: 1;
  font-size: 22rpx;
  color: #fff;
}

.modal-general-exp {
  font-size: 20rpx;
  color: #7fff00;
}

.modal-close {
  padding: 12rpx;
  text-align: center;
  background: #333;
  border-radius: 6rpx;
  color: #999;
  font-size: 22rpx;
  margin-top: 15rpx;
}

/* 招募结果弹窗 */
.recruit-result {
  text-align: center;
}

.recruit-general {
  padding: 20rpx;
}

.recruit-portrait {
  width: 150rpx;
  height: 150rpx;
  margin: 0 auto 15rpx;
  border-radius: 12rpx;
  overflow: hidden;
  border: 3rpx solid #ffd700;
  background: #2a1a0a;
}

.recruit-portrait image {
  width: 100%;
  height: 100%;
}

.recruit-result .recruit-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.recruit-quality {
  font-size: 22rpx;
  color: #ffd700;
  background: rgba(255,215,0,0.2);
  padding: 4rpx 16rpx;
  border-radius: 4rpx;
}

.recruit-result .modal-btn.confirm {
  background: linear-gradient(180deg, #4a6020 0%, #2a4010 100%);
  border-color: #6a8030;
  color: #bfff00;
}
